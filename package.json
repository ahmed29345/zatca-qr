{
  "name": "@ahmed29345/zatca-qr",
  "version": "1.0.0",
  "description": "Dependency-free TypeScript encoder and decoder for the ZATCA (FATOORA) e-invoice QR code: TLV + Base64, with validation.",
  "keywords": [
    "zatca",
    "fatoora",
    "e-invoice",
    "einvoice",
    "saudi-arabia",
    "vat",
    "qr",
    "tlv"
  ],
  "author": "Muhammad Ahmed Raza Memon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmed29345/zatca-qr.git"
  },
  "homepage": "https://github.com/ahmed29345/zatca-qr#readme",
  "bugs": "https://github.com/ahmed29345/zatca-qr/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint . && npm run typecheck",
    "example": "npm run build && node examples/generate-qr.mjs",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "eslint": "^10.14.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "esbuild": "^0.28.2"
  }
}
